# Copier en `.env` pour surcharger les valeurs par défaut (voir services/api/src/jurirag/config.py).
# Aucun secret : le projet n'appelle aucun service externe.

# --- Ollama (serveur LLM local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
REQUEST_TIMEOUT_S=180
OLLAMA_KEEP_ALIVE=30m

# --- Génération ---
TEMPERATURE=0.1
JUDGE_TEMPERATURE=0.0
SEED=42
TOP_P=0.9
NUM_PREDICT=1024
NUM_CTX=16384
THINK=false
THINK_DECIDE=true

# --- Agent ---
AGENT_MAX_ITERATIONS=5
HITL_TIMEOUT_S=300
MEMORY_TTL_S=7200

# --- Retrieval ---
RETRIEVAL_K=5
RETRIEVAL_METHOD=hybrid
RETRIEVAL_CANDIDATES=50
RRF_K=60

# --- Corpus & index ---
DATA_DIR=data
INDEX_NAME=main
CHUNK_TOKENS=450
CHUNK_OVERLAP=0.15

# --- API / interface ---
API_HOST=127.0.0.1
API_PORT=8000
JURIRAG_API_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
